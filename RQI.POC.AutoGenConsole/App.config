<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
		<add key="ConnectionStringOLD" value="Server=PC-J1FX2X2;Database=Retrieval_Management;Trusted_Connection=True;MultipleActiveResultSets=true;Enlist='false';" />
		<add key="ConnectionStringAzure" value="Server=tcp:noahplatform-dev.database.windows.net,1433;Initial Catalog=db-noah-platform-dev;Persist Security Info=False;User ID=noahAdmin;Password=***REMOVED***;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;" />
		<add key="ConnectionString" value="Server=DESKTOP-D30MVDA;Initial Catalog=GBDC_MAIN;Persist Security Info=False;User ID=sa;Password=***REMOVED***;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=False;Connection Timeout=30;" />
		<add key="RQI.POC.AutoGen.Namespace" value="RQI.POC.EFModels.POCOS" />
        <add key="RQI.POC.AutoGen.IncludeProcedureList" value="^cust*" />
        <add key="RQI.POC.AutoGen.ExcludeProcedureList" value="^custFx*" />
        <add key="RQI.POC.AutoGen.IncludeTableList" value="*" /> <!-- '*' means all tables -->
        <add key="RQI.POC.AutoGen.ExcludeTableList" value="sysdiagrams,dtproperty,MSreplication_objects,MSreplication_subscriptions,MSsavedforeignkeycolumns,MSsavedforeignkeyextendedproperties,MSsavedforeignkeys,MSsnapshotdeliveryprogress,MSsubscription_agents,MSsubscription_properties,^temp$,__RefactorLog,AccessLevels,TableAccessLevels,UserLogin,TableInnerJoins,SeasonSummerSeasonMaps" />
        <add key="RQI.POC.AutoGen.IncludeViewList" value="*" /><!-- '*' means all views -->
        <add key="RQI.POC.AutoGen.ExcludeViewList" value="^vwGen_*,vwUserExperienceSchedules" />
		<add key="RQI.POC.AutoGen.HistoricalColumns" value="IsActive,IsDeleted,CreatedById,CreatedDate,ModifiedById,ModifiedDate" />
		<add key="RQI.POC.AutoGen.AuditorColumns" value="DEX_ROW_TS,DEX_ROW" />

		<add key="RQI.POC.AutoGen.TableSchemaList" value="ACC,BAS,GBD,MAC,WAL" />
        <add key="RQI.POC.AutoGen.ViewsSchemaList" value="ACC,BAS,GBD,MAC,WAL" />
        <add key="RQI.POC.AutoGen.StPrcSchemaList" value="ACC,BAS,GBD,MAC,WAL" />
        <add key="RQI.POC.AutoGen.RegexIgnoreCase" value="false" />
        <add key="RQI.POC.AutoGen.RegexReplaceExpression" value="" />
        <add key="RQI.POC.AutoGen.RegexMatchExpression" value="" />
        <add key="RQI.POC.AutoGen.RegexDictionaryReplace" value="^vw_(.*),$1View;^vw([A-Z]{2})_(.*),$1\_$2View;vw(.*),$1View;^VW_(.*),$1View;^cust([A-Z][A-Z][A-Z]?)_,$1\_;^proc_([A-Z][A-Z][A-Z]?)_,$1\_;^([A-Z][A-Z][A-Z]?)_,$1\_" />
        <add key="RQI.POC.AutoGen.StripText" value="^cust_|^cust" />
        <add key="RQI.POC.AutoGen.EnumTableList" value="" />
        <add key="RQI.POC.AutoGen.MetaDataTableList" value="" />
        <add key="RQI.POC.AutoGen.SQL.SystemColToIgnoreList" value="DEX_ROW,DEX_ROW_TS" />
        <add key="RQI.POC.AutoGen.SQL.ColumnDataTypeToIgnoreList" value="" />
        <add key="RQI.POC.AutoGen.SkipPluralNamesList" value="Abara,EasyAccess,HartSoftware,VendorManual,Microbilt" />
        <add key="RQI.POC.AutoGen.WordsShouldEndES" value="Status,Address,Prefix" />

		<add key="RQI.GEN.OutputBaseDir" value="C:\ExternalData\Business" />
		<add key="RQI.GEN.BaseNameSpace" value="NOAH" />
		<add key="RQI.GEN.FacadeNameSpace" value="NOAH.Business.Facade" />
		<add key="RQI.GEN.DataAccessNameSpace" value="NOAH.DataAccess" />
		<add key="RQI.GEN.TableTemplateFilePath" value="D:\CodeBaseQUAD\NOAH\Source\NOAH.Data\Templates\TableModel.txt" />
		<add key="RQI.GEN.ViewTemplateFilePath" value="D:\CodeBaseQUAD\NOAH\Source\NOAH.Data\Templates\ViewModel.txt" />
		<add key="RQI.GEN.DataAccessRootFilePath" value="D:\CodeBaseQUAD\NOAH\Source\NOAH.Data" />

	</appSettings>
    <connectionStrings>
