<?xml version="1.0" encoding="utf-8"?>
<!-- Dev Environment Configuration -->
<!-- To use: Build with "Dev" configuration and SlowCheetah will apply these transforms -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
    <appSettings>
        <!-- Connection Strings -->
        <add key="ConnectionString" 
             value="Server=DESKTOP-GAHBRKG;Initial Catalog=SOL_MAIN;Persist Security Info=False;User ID=sa;Password=***REMOVED***;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=False;Connection Timeout=30;" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        
        <!-- AutoGen Settings -->
        <add key="RQI.POC.AutoGen.Namespace" value="RQI.POC.EFModels.POCOS" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.IncludeProcedureList" value="*" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.ExcludeProcedureList" value="^custFx*,.*\.spAutoGen_*" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.IncludeTableList" value="*" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.ExcludeTableList" value="sysdiagrams,dtproperty,MSreplication_objects,MSreplication_subscriptions,MSsavedforeignkeycolumns,MSsavedforeignkeyextendedproperties,MSsavedforeignkeys,MSsnapshotdeliveryprogress,MSsubscription_agents,MSsubscription_properties,^temp$,__RefactorLog,AccessLevels,TableAccessLevels,UserLogin,TableInnerJoins,SeasonSummerSeasonMaps" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.IncludeViewList" value="*" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.ExcludeViewList" value="^vwGen_*,vwUserExperienceSchedules" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.HistoricalColumns" value="IsActive,IsDeleted,CreatedById,CreatedDate,ModifiedById,ModifiedDate" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.AuditorColumns" value="DEX_ROW_TS,DEX_ROW" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        
        <!-- Schema Lists -->
        <add key="RQI.POC.AutoGen.TableSchemaList" value="ACC,ACE,MAC,QAL,RSU" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.ViewsSchemaList" value="ACC,ACE,MAC,QAL,RSU" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.StPrcSchemaList" value="ACC,ACE,MAC,QAL,RSU" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.StUDTSchemaList" value="ACC,ACE,MAC,QAL,RSU" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.CriticalDataTypesSchemaList" value="ACC,ACE,MAC,QAL,RSU" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.CriticalDataTypesTablesList" value="[ACC].[DealerTenantTypes]"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        
        <!-- Regex Settings -->
        <add key="RQI.POC.AutoGen.RegexIgnoreCase" value="false" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.RegexReplaceExpression" value="" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.RegexMatchExpression" value="" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.RegexDictionaryReplace" value="^vw_(.*),$1View;^vw([A-Z]{2})_(.*),$1\_$2View;vw(.*),$1View;^VW_(.*),$1View;^cust([A-Z][A-Z][A-Z]?)_,$1\_;^proc_([A-Z][A-Z][A-Z]?)_,$1\_;^([A-Z][A-Z][A-Z]?)_,$1\_" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.StripText" value="^cust_|^cust" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        
        <!-- Other AutoGen Settings -->
        <add key="RQI.POC.AutoGen.EnumTableList" value="" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.MetaDataTableList" value="" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.SQL.SystemColToIgnoreList" value="DEX_ROW,DEX_ROW_TS" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.SQL.ColumnDataTypeToIgnoreList" value="" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.SkipPluralNamesList" value="Abara,EasyAccess,HartSoftware,VendorManual,Microbilt" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.POC.AutoGen.WordsShouldEndES" value="Status,Address,Prefix" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        
        <!-- RQI.GEN Settings - Update these paths for Dev environment -->
        <add key="RQI.GEN.OutputBaseDir" value="C:\ExternalData\Business" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.GEN.BaseNameSpace" value="Solasta" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.GEN.FacadeNameSpace" value="Solasta.Business.Facade" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.DataDataNameSpace" value="Solasta.Data"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.DataAccessNameSpace" value="Solasta.DataAccess"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.DbContextFileName" value="SolastaDbContext"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.TableTemplateFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data\Templates\TableModel.txt" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.GEN.ViewTemplateFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data\Templates\ViewModel.txt" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.GEN.UDDTTemplateFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data\Templates\UDDTModel.txt" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
        <add key="RQI.GEN.SPROCTemplateFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.DataAccess\Templates\SPROC.txt" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.ProxyTypeTemplateFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data\Templates\ProxyTableLookupModel.txt"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.DbContextTemplateFilePath" value=".\Templates\Files\Dev\DbContextTemplate.txt"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.RepositoryInterfaceTemplateFilePath" value=".\Templates\Files\Dev\RepositoryInterfaceTemplate.txt"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.RepositoryTemplateFilePath" value=".\Templates\Files\Dev\RepositoryTemplate.txt"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.UnitOfWorkTemplateFilePath" value=".\Templates\Files\Dev\UnitOfWorkTemplate.txt"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.UnitOfWorkInterfaceTemplateFilePath" value=".\Templates\Files\Dev\UnitOfWorkInterfaceTemplate.txt"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

		<add key="RQI.GEN.DbContextNamespance" value="Solasta.Data.Repository"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.DbContextFileName" value="SolastaDbContext"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.DbContextConnectionStringName" value="DefaultConnection"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />

		<add key="RQI.GEN.DataModelsRootFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.DataAccessRootFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.DataAccess" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.RepositoryRootFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data.Repository"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.Data.EntityRootFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data.Entity"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.ProxyTypeRootFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.Data\Utilities" 
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.UnitOfWorkNameSpace" value="Solasta.DataAccess"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.UnitOfWorkFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.DataAccess\UnitOfWork.generated.cs"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
		<add key="RQI.GEN.UnitOfWorkInterfaceFilePath" value="D:\CodeBaseSOLA\Repos\solasta-lighting-est-api\Source\Solasta\Solasta.DataAccess\IUnitOfWork.generated.cs"
             xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    </appSettings>
    <connectionStrings>
        <!-- Transform: Replace GBDCDbContext for Dev environment -->
        <add name="GBDCDbContext" 
             providerName="System.Data.SqlClient" 
             connectionString="Server=DESKTOP-GAHBRKG;Initial Catalog=SOL_MAIN;Persist Security Info=False;User ID=sa;Password=***REMOVED***;MultipleActiveResultSets=False;Encrypt=False;TrustServerCertificate=False;Connection Timeout=30;" 
